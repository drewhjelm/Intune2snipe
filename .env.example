# Intune2Snipe Configuration
# Copy this file to .env and fill in your actual values
# The .env file will be automatically loaded when you run the script

# ─── Azure AD Configuration ──────────────────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here

# ─── Azure AD Authentication ─────────────────────────────────────────────────────
# Choose ONE of the following authentication methods:

# Method 1: Certificate authentication (recommended — no expiry management)
# Option A: Combined certificate and private key
AZURE_COMBINED_CERT_KEY="-----BEGIN CERTIFICATE-----
MIIDXTCCAkWgAwIBAgIJAKJ...
your-certificate-content-here...
-----END CERTIFICATE-----
-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...
your-private-key-content-here...
-----END PRIVATE KEY-----"

# Option B: Separate certificate and key (better for secret stores)
# The script will automatically combine them at runtime
# AZURE_CERTIFICATE_PEM="-----BEGIN CERTIFICATE-----
# MIIDXTCCAkWgAwIBAgIJAKJ...
# your-certificate-content-here...
# -----END CERTIFICATE-----"
#
# AZURE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----
# MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...
# your-private-key-content-here...
# -----END PRIVATE KEY-----"

# Method 2: Client secret (simpler setup, but secrets expire and must be rotated)
# If certificate vars are also set, certificate takes priority
# AZURE_CLIENT_SECRET=your-client-secret-here

# ─── Snipe-IT Configuration ──────────────────────────────────────────────────────
SNIPEIT_URL=https://your-snipeit-instance.com/api/v1
SNIPEIT_API_TOKEN=your-snipeit-api-token-here
SNIPEIT_DEFAULT_STATUS="Ready to Deploy"

# ─── Optional: Azure AD Group Filtering ─────────────────────────────────────────
# Comma-separated list of Azure AD group object IDs
# Only devices in these groups will be synced
# AZURE_GROUP_IDS=group-id-1,group-id-2,group-id-3

# ─── Optional: Secret Store Configuration ───────────────────────────────────────
# If using HashiCorp Vault
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=your-vault-token

# If using Azure Key Vault
# AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net/

# AWS credentials are typically loaded from ~/.aws/credentials or IAM role
